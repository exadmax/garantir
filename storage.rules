rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Cada usuario so pode ler/escrever as proprias notas fiscais.
    match /invoices/{uid}/{productId}/{fileName} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Bloqueia qualquer outro caminho por padrao.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
